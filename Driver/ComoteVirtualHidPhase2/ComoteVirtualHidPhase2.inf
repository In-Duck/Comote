[Version]
Signature="$WINDOWS NT$"
Class=System
ClassGuid={4d36e97d-e325-11ce-bfc1-08002be10318}
Provider=%ProviderName%
DriverVer=07/30/2026,0.2.0.0
CatalogFile=ComoteVirtualHidPhase2.cat
PnpLockdown=1

[DestinationDirs]
DefaultDestDir=13
ComoteDriverCopy=13

[SourceDisksNames]
1=%DiskName%,,,

[SourceDisksFiles]
ComoteVirtualHidPhase2.sys=1

[Manufacturer]
%ProviderName%=ComoteModels,NTamd64.10.0...19045

[ComoteModels.NTamd64.10.0...19045]
%DeviceDescription%=ComoteVirtualHidPhase2_Install,ROOT\COMOTEVIRTUALHID_PHASE2

[ComoteVirtualHidPhase2_Install.NT]
CopyFiles=ComoteDriverCopy

[ComoteDriverCopy]
ComoteVirtualHidPhase2.sys

[ComoteVirtualHidPhase2_Install.NT.HW]
AddReg=ComoteVirtualHidPhase2_VhfLowerFilter

[ComoteVirtualHidPhase2_VhfLowerFilter]
HKR,,"LowerFilters",0x00010000,"vhf"

[ComoteVirtualHidPhase2_Install.NT.Services]
AddService=ComoteVirtualHidPhase2,0x00000002,ComoteVirtualHidPhase2_Service

[ComoteVirtualHidPhase2_Service]
DisplayName=%ServiceDescription%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\ComoteVirtualHidPhase2.sys

[ComoteVirtualHidPhase2_Install.NT.Wdf]
KmdfService=ComoteVirtualHidPhase2,ComoteVirtualHidPhase2_Wdf

[ComoteVirtualHidPhase2_Wdf]
KmdfLibraryVersion=1.15

[Strings]
ProviderName="Comote"
DeviceDescription="Comote Virtual HID Phase 2 Source"
ServiceDescription="Comote Virtual HID Phase 2 Source Driver"
DiskName="Comote Virtual HID Phase 2 Installation Media"
