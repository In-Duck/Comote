[Version]
Signature="$WINDOWS NT$"
Class=System
ClassGuid={4d36e97d-e325-11ce-bfc1-08002be10318}
Provider=%ProviderName%
DriverVer=07/29/2026,0.1.0.0
CatalogFile=ComoteVirtualHid.cat
PnpLockdown=1

[DestinationDirs]
DefaultDestDir=12
ComoteDriverCopy=12

[SourceDisksNames]
1=%DiskName%,,,

[SourceDisksFiles]
ComoteVirtualHid.sys=1

[Manufacturer]
%ProviderName%=ComoteModels,NTamd64

[ComoteModels.NTamd64]
%DeviceDescription%=ComoteVirtualHid_Install,ROOT\COMOTEVIRTUALHID

[ComoteVirtualHid_Install.NT]
CopyFiles=ComoteDriverCopy

[ComoteDriverCopy]
ComoteVirtualHid.sys

[ComoteVirtualHid_Install.NT.HW]
AddReg=ComoteVirtualHid_VhfLowerFilter

[ComoteVirtualHid_VhfLowerFilter]
HKR,,"LowerFilters",0x00010000,"vhf"

[ComoteVirtualHid_Install.NT.Services]
AddService=ComoteVirtualHid,0x00000002,ComoteVirtualHid_Service

[ComoteVirtualHid_Service]
DisplayName=%ServiceDescription%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%12%\ComoteVirtualHid.sys

[ComoteVirtualHid_Install.NT.Wdf]
KmdfService=ComoteVirtualHid,ComoteVirtualHid_Wdf

[ComoteVirtualHid_Wdf]
KmdfLibraryVersion=1.15

[Strings]
ProviderName="Comote"
DeviceDescription="Comote Virtual HID Source"
ServiceDescription="Comote Virtual HID Source Driver"
DiskName="Comote Virtual HID Installation Media"

