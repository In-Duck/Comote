[Version]
Signature="$WINDOWS NT$"
Class=HIDClass
ClassGuid={745a17a0-74d3-11d0-b6fe-00a0c90f57da}
Provider=%Provider%
DriverVer=07/21/2026,1.0.0.0
CatalogFile=ComoteVirtualHid.cat
PnpLockdown=1

[DestinationDirs]
DefaultDestDir=13

[SourceDisksNames]
1=%DiskDescription%,,,

[SourceDisksFiles]
ComoteVirtualHid.sys=1

[Manufacturer]
%Manufacturer%=Models,NT$ARCH$.10.0...19041

[Models.NT$ARCH$.10.0...19041]
%DeviceDescription%=ComoteVirtualHid_Install,Root\ComoteVirtualHid

[ComoteVirtualHid_Install.NT]
CopyFiles=DriverCopy

[DriverCopy]
ComoteVirtualHid.sys

[ComoteVirtualHid_Install.NT.HW]
AddReg=ComoteVirtualHid_Hardware

[ComoteVirtualHid_Hardware]
HKR,,"LowerFilters",0x00010008,"vhf"
HKR,,"Security",,"D:P(A;;GA;;;SY)(A;;GA;;;BA)(A;;GRGW;;;BU)"

[ComoteVirtualHid_Install.NT.Services]
AddService=ComoteVirtualHid,%SPSVCINST_ASSOCSERVICE%,ComoteVirtualHid_Service

[ComoteVirtualHid_Service]
DisplayName=%ServiceDescription%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\ComoteVirtualHid.sys

[ComoteVirtualHid_Install.NT.Wdf]
KmdfService=ComoteVirtualHid,ComoteVirtualHid_Wdf

[ComoteVirtualHid_Wdf]
KmdfLibraryVersion=$KMDFVERSION$

[Strings]
SPSVCINST_ASSOCSERVICE=0x00000002
Provider="Comote Project"
Manufacturer="Comote Project"
DeviceDescription="Comote Virtual HID Keyboard and Mouse"
ServiceDescription="Comote Virtual HID Service"
DiskDescription="Comote Virtual HID Driver"
